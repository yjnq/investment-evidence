# PostgreSQL is required for hosted deployment. Without it, local development uses persistent PGlite.
DATABASE_URL=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=
# Required for writes in production. Enter it in the browser access field.
APP_ACCESS_TOKEN=
# Local optional: reference an existing OpenCode configuration; no credential is copied.
OPENCODE_CONFIG_PATH=
# iFinD: environment token in hosting; path reference for local development.
IFIND_AUTH_TOKEN=
IFIND_CONFIG_PATH=
APP_ORIGIN=
